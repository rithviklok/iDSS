# Supabase Configuration (optional - app works with mock data without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# DSS Backend API (for sensors, issues, etc.)
VITE_DSS_API_BASE=http://localhost:3000

# Local frontend-only run: skip backend auth + use bundled dummy data (copy to `.env.local`)
VITE_DUMMY_DATA=true

# Vercel / public demo: set in Project → Settings → Environment Variables (Production)
# so the built bundle uses mocks and needs no DSS API.
# VITE_DUMMY_DATA=true
